{
  "projectName": "ecommerce",
  "database": "postgresql",
  "enums": [
    {
      "name": "user_role",
      "values": ["admin", "customer"]
    }
  ],
  "tables": [
    {
      "name": "users",
      "description": "Store users",
      "timestamps": true,
      "softDelete": false,
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "primaryKey": true,
          "nullable": false,
          "unique": true,
          "defaultValue": "gen_random_uuid()",
          "description": "PK"
        },
        {
          "name": "email",
          "type": "varchar(255)",
          "primaryKey": false,
          "nullable": false,
          "unique": true,
          "description": "User email"
        },
        {
          "name": "role",
          "type": "user_role",
          "primaryKey": false,
          "nullable": false,
          "unique": false,
          "defaultValue": "'customer'",
          "description": "User role"
        }
      ],
      "indexes": []
    },
    {
      "name": "orders",
      "description": "User orders",
      "timestamps": true,
      "softDelete": false,
      "columns": [
        {
          "name": "id",
          "type": "uuid",
          "primaryKey": true,
          "nullable": false,
          "unique": true,
          "defaultValue": "gen_random_uuid()",
          "description": "PK"
        },
        {
          "name": "user_id",
          "type": "uuid",
          "primaryKey": false,
          "nullable": false,
          "unique": false,
          "description": "Order owner",
          "references": {
            "table": "users",
            "column": "id",
            "onDelete": "CASCADE"
          }
        },
        {
          "name": "total",
          "type": "decimal(10,2)",
          "primaryKey": false,
          "nullable": false,
          "unique": false,
          "description": "Total amount"
        }
      ],
      "indexes": [
        {
          "name": "idx_orders_user",
          "columns": ["user_id"],
          "unique": false
        }
      ]
    }
  ]
}
